.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.factorypath
.springBeans
.sts4-cache/
.metadata/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
*.code-workspace
/.debtdoctor
/.metrics

# Operating system / editor artifacts
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
*.swo

